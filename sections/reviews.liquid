{%- comment -%} Purelane Reviews Rail (#reviews) — block-based reviews with auto marquee {%- endcomment -%}

<section class="pl-revband" id="reviews" data-scene="1">
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <span class="pl-agg"><span class="pl-st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>{{ section.settings.rating_avg }}</b> from {{ section.settings.review_count }}</span>
      <span class="pl-agg">Loved by <b>{{ section.settings.homes_count }}</b> homes</span>
    </div>
  </div>

  {%- assign block_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign block_count = block_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

  {%- if block_count > 0 -%}
  <div class="pl-revrail pl-rv" aria-label="Customer reviews">
    <div class="pl-revtrack" data-pl-revtrack>
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="pl-glass2 pl-rcard" {{ block.shopify_attributes }}>
            <div class="pl-st">
              {%- assign stars = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}{%- if i <= stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}
            </div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.body }}</p>
            <div class="pl-who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              {%- if block.settings.product_name != blank -%}<span>&middot; {{ block.settings.product_name }}</span>{%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} duplicate set for seamless marquee loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="pl-glass2 pl-rcard" aria-hidden="true">
            <div class="pl-st">
              {%- assign stars = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}{%- if i <= stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}
            </div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.body }}</p>
            <div class="pl-who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              {%- if block.settings.product_name != blank -%}<span>&middot; {{ block.settings.product_name }}</span>{%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>

{% stylesheet %}
.pl-revband{position:relative;z-index:2;padding:34px 0;background:linear-gradient(178deg,#12907f 0%,#04756e 26%,#4b3a8f 58%,#01514d 100%)}
.pl-wrap{max-width:1180px;margin:0 auto;padding:0 18px}
.pl-glass2{background:linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));backdrop-filter:blur(18px) saturate(135%);-webkit-backdrop-filter:blur(18px) saturate(135%);border:1px solid rgba(236,230,247,.16);border-radius:26px;box-shadow:0 18px 48px rgba(18,12,34,.36),inset 0 1px 0 rgba(255,255,255,.16);position:relative;overflow:hidden}
.pl-kicker{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(236,230,247,.52);display:block;margin-bottom:12px}
.pl-revhead{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-bottom:20px}
.pl-agg{font-size:13px;color:rgba(236,230,247,.8);display:flex;align-items:center;gap:6px}
.pl-agg .pl-st{color:#f0a03c;letter-spacing:2px}
.pl-agg b{color:#faf7fd}
.pl-revrail{overflow:hidden}
.pl-revtrack{display:flex;gap:14px;width:max-content;animation:pl-marquee 40s linear infinite}
.pl-revtrack:hover{animation-play-state:paused}
@keyframes pl-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.pl-rcard{padding:20px;width:260px;flex:0 0 auto}
.pl-rcard .pl-st{color:#f0a03c;font-size:13px;letter-spacing:2px;margin-bottom:10px}
.pl-rcard h5{font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;color:#faf7fd;margin-bottom:8px}
.pl-rcard p{font-size:13px;color:rgba(236,230,247,.75);line-height:1.5;margin-bottom:14px}
.pl-who{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(236,230,247,.6)}
.pl-who svg{width:14px;height:14px;color:#f0a03c;flex:0 0 auto}
.pl-who b{color:#faf7fd}
.pl-rv{opacity:0;transform:translateY(30px);filter:blur(7px);transition:opacity .95s cubic-bezier(.2,.7,.2,1),transform .95s cubic-bezier(.2,.7,.2,1),filter .95s cubic-bezier(.2,.7,.2,1)}
.pl-rv.pl-in{opacity:1;transform:none;filter:none}
@media(prefers-reduced-motion: reduce){.pl-rv{transition:none!important;opacity:1;transform:none;filter:none}.pl-revtrack{animation:none}}
@media(max-width:600px){.pl-rcard{width:220px}}
{% endstylesheet %}

{% javascript %}
var plRevObserver = new IntersectionObserver(function (entries) {
  entries.forEach(function (entry) { if (entry.isIntersecting) entry.target.classList.add('pl-in'); });
}, { threshold: 0.1 });
document.querySelectorAll('.pl-revband .pl-rv').forEach(function (el) { plRevObserver.observe(el); });
{% endjavascript %}

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating_avg", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "8,000+ reviews" },
    { "type": "text", "id": "homes_count", "label": "Homes count text", "default": "12 lakh+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "body", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author name", "default": "Verified buyer" },
        { "type": "text", "id": "product_name", "label": "Product name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product_name": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "body": "Our old dishwash left my hands dry and cracked. That stopped completely after we switched.", "author": "Priya", "product_name": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Dog friendly", "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product_name": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product_name": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}