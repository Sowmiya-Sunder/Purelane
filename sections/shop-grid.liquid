{%- comment -%}
  Purelane Shop Grid (#shop)
  - Backed by a real Shopify collection, not blocks — merchant swaps the
    collection and every card updates automatically.
  - Handles all three required edge cases: sold out, missing image, long title.
  - "Best seller / Top rated / New" pill is tag-driven so a merchant can
    control it from the product admin without touching code.
{%- endcomment -%}

<section class="pl-shop" id="shop" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-panelhead pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- assign coll = section.settings.collection -%}
    {%- if coll != blank and coll.products.size > 0 -%}
    <div class="pl-shelf">
      {%- for product in coll.products limit: section.settings.products_to_show -%}
        {%- assign is_sold_out = false -%}
        {%- unless product.available -%}{%- assign is_sold_out = true -%}{%- endunless -%}

        {%- assign pill_text = blank -%}
        {%- if product.tags contains 'bestseller' -%}
          {%- assign pill_text = 'Best seller' -%}
        {%- elsif product.tags contains 'top-rated' -%}
          {%- assign pill_text = 'Top rated' -%}
        {%- elsif product.tags contains 'new' -%}
          {%- assign pill_text = 'New' -%}
        {%- endif -%}

        {%- assign rating = product.metafields.reviews.rating.value.rating -%}
        {%- assign rating_count = product.metafields.reviews.rating_count.value -%}

        <article class="pl-card pl-glass pl-rv{% if forloop.index0 > 0 %} pl-rv-d{{ forloop.index0 | at_most: 5 }}{% endif %}{% if is_sold_out %} pl-card--soldout{% endif %}">
          <a href="{{ product.url }}" class="pl-card__shot">
            {%- if pill_text != blank -%}<span class="pl-pill">{{ pill_text }}</span>{%- endif -%}
            {%- if is_sold_out -%}<span class="pl-pill pl-pill--sold">Sold out</span>{%- endif -%}
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
            {%- else -%}
              <span class="pl-card__noimg" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </span>
            {%- endif -%}
          </a>

          <h4 class="pl-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h4>

          {%- if rating != blank -%}
          <div class="pl-rate"><b>&#9733; {{ rating }}</b> &middot; {{ rating_count | default: 0 }} reviews</div>
          {%- endif -%}

          <div class="pl-pr">
            <strong>{{ product.price | money }}</strong>
            {%- if product.compare_at_price > product.price -%}
              <s>{{ product.compare_at_price | money }}</s>
              {%- assign off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <em>{{ off }}% off</em>
            {%- endif -%}
          </div>

          {%- if is_sold_out -%}
            <button class="pl-btn pl-btn--ghost pl-btn--sm" disabled>Sold out</button>
          {%- else -%}
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="pl-btn pl-btn--ghost pl-btn--sm">Add to cart</button>
            {%- endform -%}
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- else -%}
    <div class="pl-empty-state pl-glass">
      <p>Select a collection with products in the section settings to populate this grid.</p>
    </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pl-shop{position:relative;z-index:2;padding:34px 0;background:linear-gradient(178deg,#1a6b5f 0%,#0f5a52 50%,#17102b 100%)}
.pl-wrap{max-width:1180px;margin:0 auto;padding:0 18px}
.pl-panelhead{text-align:center;max-width:640px;margin:0 auto 28px}
.pl-kicker{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(236,230,247,.52)}
.pl-d2{font-family:'Outfit',system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.018em;font-weight:800;line-height:.94;color:#faf7fd;font-size:clamp(30px,4.6vw,54px)}
.pl-rule{display:flex;align-items:center;gap:13px;margin:14px auto 0;max-width:240px;justify-content:center}
.pl-rule i{height:1px;flex:1;background:linear-gradient(90deg,transparent,rgba(236,230,247,.44))}
.pl-rule i:last-child{background:linear-gradient(90deg,rgba(236,230,247,.44),transparent)}
.pl-rule svg{width:16px;height:16px;color:#f0a03c;flex:0 0 auto}
.pl-glass{background:linear-gradient(158deg,rgba(236,230,247,.15),rgba(75,58,143,.20) 58%,rgba(23,16,43,.28));backdrop-filter:blur(24px) saturate(150%);-webkit-backdrop-filter:blur(24px) saturate(150%);border:1px solid rgba(236,230,247,.22);border-radius:26px;box-shadow:0 26px 74px rgba(18,12,34,.44),inset 0 1px 0 rgba(255,255,255,.24);position:relative;overflow:hidden}
.pl-shelf{display:grid;gap:14px;grid-template-columns:repeat(2,1fr)}
@media(min-width:860px){.pl-shelf{grid-template-columns:repeat(4,1fr)}}
.pl-card{padding:16px;display:flex;flex-direction:column;transition:.4s cubic-bezier(.2,.7,.2,1)}
.pl-card:hover{transform:translateY(-5px)}
.pl-card__shot{height:150px;border-radius:14px;margin-bottom:14px;display:grid;place-items:center;position:relative;overflow:hidden;background:linear-gradient(160deg,rgba(236,230,247,.12),rgba(75,58,143,.2));border:1px solid rgba(236,230,247,.14)}
.pl-card__shot img{max-height:122px;width:auto;object-fit:contain}
.pl-card__noimg{color:rgba(236,230,247,.3)}
.pl-card__noimg svg{width:40px;height:40px}
.pl-pill{position:absolute;top:9px;left:9px;font-size:8.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;padding:4px 9px;border-radius:999px;background:rgba(23,16,43,.6);border:1px solid rgba(240,160,60,.32);color:#f0a03c;z-index:2}
.pl-pill--sold{left:auto;right:9px;border-color:rgba(236,230,247,.32);color:#ece6f7}
.pl-card--soldout .pl-card__shot img{opacity:.45}
.pl-card__title{font-family:'Outfit',sans-serif;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:#faf7fd;line-height:1.2;margin-bottom:7px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pl-card__title a{color:inherit;text-decoration:none}
.pl-rate{font-size:11.5px;color:rgba(236,230,247,.74);margin-bottom:10px;display:flex;align-items:center;gap:5px}
.pl-rate b{color:#f0a03c;font-weight:700}
.pl-pr{margin-top:auto;display:flex;align-items:baseline;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.pl-pr strong{font-family:'Outfit',sans-serif;font-size:18px;color:#faf7fd;font-weight:700}
.pl-pr s{font-size:12px;color:rgba(236,230,247,.52)}
.pl-pr em{font-style:normal;font-size:10px;font-weight:800;letter-spacing:.08em;color:#f0a03c}
.pl-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:38px;padding:0 18px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;transition:.35s cubic-bezier(.2,.7,.2,1);width:100%;border:none;cursor:pointer}
.pl-btn--ghost{background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.30);color:#faf7fd}
.pl-btn--ghost:hover{background:rgba(236,230,247,.18)}
.pl-btn--ghost:disabled{opacity:.45;cursor:not-allowed}
.pl-empty-state{padding:40px;text-align:center;color:rgba(236,230,247,.6)}
.pl-rv{opacity:0;transform:translateY(30px);filter:blur(7px);transition:opacity .95s cubic-bezier(.2,.7,.2,1),transform .95s cubic-bezier(.2,.7,.2,1),filter .95s cubic-bezier(.2,.7,.2,1)}
.pl-rv.pl-in{opacity:1;transform:none;filter:none}
.pl-rv-d1{transition-delay:.09s}
.pl-rv-d2{transition-delay:.18s}
.pl-rv-d3{transition-delay:.27s}
.pl-rv-d4{transition-delay:.36s}
.pl-rv-d5{transition-delay:.45s}
@media(prefers-reduced-motion: reduce){.pl-rv,.pl-card{transition:none!important}.pl-rv{opacity:1;transform:none;filter:none}}
@media(max-width:600px){.pl-card__shot{height:126px}.pl-card__shot img{max-height:108px}}
{% endstylesheet %}

{% javascript %}
var plShopObserver = new IntersectionObserver(function (entries) {
  entries.forEach(function (entry) {
    if (entry.isIntersecting) entry.target.classList.add('pl-in');
  });
}, { threshold: 0.15 });
document.querySelectorAll('.pl-shop .pl-rv').forEach(function (el) {
  plShopObserver.observe(el);
});
{% endjavascript %}

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "pl-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products, prices, images and stock status are pulled live from this collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}