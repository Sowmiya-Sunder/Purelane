{%- comment -%}
  Purelane Hero

  - Carousel states are theme-editor blocks (add/remove/reorder freely).
  - Each state's price/compare-at/savings is computed live from the
    real Shopify products picked in that block — nothing hardcoded.
{%- endcomment -%}

<section class="pl-hero" data-scene="1">
  <div class="pl-hero__grid">

    {%- if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank or section.settings.badge_3_text != blank -%}
      <div class="pl-badges pl-glass2" aria-label="Product promises">
        {%- for i in (1..3) -%}
          {%- assign badge_text = 'badge_' | append: i | append: '_text' -%}
          {%- assign badge_icon = 'badge_' | append: i | append: '_icon' -%}
          {%- assign text = section.settings[badge_text] -%}
          {%- assign icon = section.settings[badge_icon] -%}

          {%- if text != blank -%}
            <div class="pl-badge">
              <span class="pl-badge__icon">
                {%- case icon -%}

                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                      <path d="m9 12 2.2 2.2L15.4 10"/>
                    </svg>

                  {%- when 'spark' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="8.4"/>
                      <path d="M6.4 17.6 17.6 6.4"/>
                    </svg>

                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                    </svg>

                {%- endcase -%}
              </span>

              <span>{{ text }}</span>
            </div>
          {%- endif -%}

        {%- endfor -%}
      </div>
    {%- endif -%}


    <div class="pl-hero__copy">

      <h1 class="pl-d1 pl-rv pl-in">
        {{- section.settings.heading -}}
      </h1>

      <div class="pl-rule pl-rv pl-rv-d1">
        <i></i>

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>
      </div>


      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede pl-rv pl-rv-d2">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}


      <div class="pl-hero__cta pl-rv pl-rv-d3">

        {%- if section.settings.primary_cta_text != blank -%}
          <a
            class="pl-btn pl-btn--primary"
            href="{{ section.settings.primary_cta_link | default: '#shop' }}"
          >
            {{ section.settings.primary_cta_text }}

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}


        {%- if section.settings.secondary_cta_text != blank -%}
          <a
            class="pl-btn pl-btn--ghost"
            href="{{ section.settings.secondary_cta_link | default: '#how' }}"
          >
            {{ section.settings.secondary_cta_text }}
          </a>
        {%- endif -%}

      </div>


      {%- if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank or section.settings.badge_3_text != blank -%}

        <div class="pl-badgestrip pl-rv pl-rv-d4">

          {%- for i in (1..3) -%}

            {%- assign badge_text = 'badge_' | append: i | append: '_text' -%}
            {%- assign badge_icon = 'badge_' | append: i | append: '_icon' -%}

            {%- assign text = section.settings[badge_text] -%}
            {%- assign icon = section.settings[badge_icon] -%}

            {%- if text != blank -%}

              <div class="pl-glass2">

                {%- case icon -%}

                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                      <path d="m9 12 2.2 2.2L15.4 10"/>
                    </svg>

                  {%- when 'spark' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="8.4"/>
                      <path d="M6.4 17.6 17.6 6.4"/>
                    </svg>

                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                    </svg>

                {%- endcase -%}

                {{ text }}

              </div>

            {%- endif -%}

          {%- endfor -%}

        </div>

      {%- endif -%}

    </div>


    {%- comment -%}
      ================= PRODUCT STAGE =================
    {%- endcomment -%}

    {%- assign state_count = 0 -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'hero_state' -%}
        {%- assign state_count = state_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}


    {%- if state_count > 0 -%}

      <div class="pl-hero__prod" data-pl-hero-prod>

        <div class="pl-hstage" data-pl-hstage>

          {%- assign slide_index = 0 -%}

          {%- for block in section.blocks -%}

            {%- if block.type == 'hero_state' -%}

              {%- assign slide_index = slide_index | plus: 1 -%}


              {%- comment -%}
                Up to 3 named product slots
              {%- endcomment -%}

              {%- assign p1 = nil -%}
              {%- assign p2 = nil -%}
              {%- assign p3 = nil -%}


              {%- if block.settings.product_handle_1 != blank -%}
                {%- assign p1 = all_products[block.settings.product_handle_1] -%}
              {%- endif -%}

              {%- if block.settings.product_handle_2 != blank -%}
                {%- assign p2 = all_products[block.settings.product_handle_2] -%}
              {%- endif -%}

              {%- if block.settings.product_handle_3 != blank -%}
                {%- assign p3 = all_products[block.settings.product_handle_3] -%}
              {%- endif -%}


              {%- assign pcount = 0 -%}

              {%- if p1 != nil -%}
                {%- assign pcount = pcount | plus: 1 -%}
              {%- endif -%}

              {%- if p2 != nil -%}
                {%- assign pcount = pcount | plus: 1 -%}
              {%- endif -%}

              {%- if p3 != nil -%}
                {%- assign pcount = pcount | plus: 1 -%}
              {%- endif -%}


              {%- comment -%}
                Live pricing from real Shopify product data
              {%- endcomment -%}

              {%- assign total_price = 0 -%}
              {%- assign compare_price = 0 -%}


              {%- if p1 != nil -%}

                {%- assign total_price = total_price | plus: p1.price -%}

                {%- if p1.compare_at_price > p1.price -%}
                  {%- assign compare_price = compare_price | plus: p1.compare_at_price -%}
                {%- else -%}
                  {%- assign compare_price = compare_price | plus: p1.price -%}
                {%- endif -%}

              {%- endif -%}


              {%- if p2 != nil -%}

                {%- assign total_price = total_price | plus: p2.price -%}

                {%- if p2.compare_at_price > p2.price -%}
                  {%- assign compare_price = compare_price | plus: p2.compare_at_price -%}
                {%- else -%}
                  {%- assign compare_price = compare_price | plus: p2.price -%}
                {%- endif -%}

              {%- endif -%}


              {%- if p3 != nil -%}

                {%- assign total_price = total_price | plus: p3.price -%}

                {%- if p3.compare_at_price > p3.price -%}
                  {%- assign compare_price = compare_price | plus: p3.compare_at_price -%}
                {%- else -%}
                  {%- assign compare_price = compare_price | plus: p3.price -%}
                {%- endif -%}

              {%- endif -%}


              {%- assign savings = compare_price | minus: total_price -%}

              {%- assign discount_pct = 0 -%}

              {%- if compare_price > 0 -%}
                {%- assign discount_pct = savings | times: 100.0 | divided_by: compare_price | round -%}
              {%- endif -%}


              <div
                class="pl-hslide{% if slide_index == 1 %} pl-on{% endif %}"
                data-pl-slide
                data-n="{{ slide_index }}"
                {{ block.shopify_attributes }}
              >

                {%- if p1 != nil -%}

                  {%- if p1.featured_image != blank -%}

                    {{
                      p1.featured_image
                      | image_url: width: 700
                      | image_tag:
                        class: 'pl-hp',
                        loading: 'lazy',
                        alt: p1.featured_image.alt | default: p1.title
                    }}

                  {%- else -%}

                    <span
                      class="pl-hp pl-hp--placeholder"
                      role="img"
                      aria-label="{{ p1.title }}"
                    ></span>

                  {%- endif -%}

                {%- endif -%}


                {%- if p2 != nil or p3 != nil -%}

                  <div class="pl-hp-thumbs">

                    {%- if p2 != nil -%}

                      {%- if p2.featured_image != blank -%}

                        {{
                          p2.featured_image
                          | image_url: width: 120
                          | image_tag:
                            class: 'pl-hp-thumb',
                            loading: 'lazy',
                            alt: p2.title
                        }}

                      {%- else -%}

                        <span
                          class="pl-hp-thumb pl-hp-thumb--empty"
                          role="img"
                          aria-label="{{ p2.title }}"
                        ></span>

                      {%- endif -%}

                    {%- endif -%}


                    {%- if p3 != nil -%}

                      {%- if p3.featured_image != blank -%}

                        {{
                          p3.featured_image
                          | image_url: width: 120
                          | image_tag:
                            class: 'pl-hp-thumb',
                            loading: 'lazy',
                            alt: p3.title
                        }}

                      {%- else -%}

                        <span
                          class="pl-hp-thumb pl-hp-thumb--empty"
                          role="img"
                          aria-label="{{ p3.title }}"
                        ></span>

                      {%- endif -%}

                    {%- endif -%}

                  </div>

                {%- endif -%}


                {%- if pcount > 0 -%}

                  <div class="pl-glass2 pl-ptag">

                    <span class="pl-lbl">
                      {{ block.settings.label | default: p1.title }}
                    </span>


                    <span class="pl-val">

                      <strong>
                        {{ total_price | money_without_trailing_zeros }}
                      </strong>

                      {%- if compare_price > total_price -%}
                        <s>
                          {{ compare_price | money_without_trailing_zeros }}
                        </s>
                      {%- endif -%}

                    </span>


                    {%- if discount_pct > 0 -%}

                      <span class="pl-cut">

                        {%- if pcount > 1 -%}
                          Save {{ savings | money_without_trailing_zeros }}
                        {%- else -%}
                          {{ discount_pct }}% off
                        {%- endif -%}

                      </span>

                    {%- endif -%}

                  </div>

                {%- endif -%}

              </div>

            {%- endif -%}

          {%- endfor -%}

        </div>


        {%- if state_count > 1 -%}

          <div class="pl-hdots" data-pl-hdots>

            {%- for i in (1..state_count) -%}

              <button
                type="button"
                class="{% if forloop.first %}pl-on{% endif %}"
                data-pl-dot
                data-n="{{ i }}"
                aria-label="Show state {{ i }}"
              ></button>

            {%- endfor -%}

          </div>

        {%- endif -%}

      </div>

    {%- endif -%}

  </div>
</section>


{% stylesheet %}

/* =========================================================
   GLOBAL SMOOTH SCROLL
   ========================================================= */

html{
  scroll-behavior:smooth;
}


/* =========================================================
   HERO
   ========================================================= */

.pl-hero{
  position:relative;
  z-index:2;
  min-height:100svh;
  display:flex;
  align-items:flex-end;
  padding:150px 0 34px;
  background:linear-gradient(
    178deg,
    #1ea38d 0%,
    #0b8578 22%,
    #017069 48%,
    #4b3a8f 74%,
    #01524e 100%
  );
}


/* Original dark gradient overlay */

.pl-hero::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  background:linear-gradient(
    102deg,
    rgba(1,45,42,.68) 0%,
    rgba(1,45,42,.40) 30%,
    rgba(1,45,42,.10) 52%,
    transparent 66%
  );
}


/* NEW: Animated dot pattern */

.pl-hero::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:1;
  pointer-events:none;
  background-image:radial-gradient(
    circle,
    rgba(255,255,255,.22) 1px,
    transparent 1.5px
  );
  background-size:60px 60px;
  animation:pl-drift 22s linear infinite;
}


/* NEW: Dot movement */

@keyframes pl-drift{
  from{
    background-position:0 0;
  }

  to{
    background-position:120px 240px;
  }
}


/* =========================================================
   HERO GRID
   ========================================================= */

.pl-hero__grid{
  max-width:1180px;
  margin:0 auto;
  padding:0 18px;
  width:100%;
  position:relative;
  z-index:2;
}


/* =========================================================
   HERO COPY
   ========================================================= */

.pl-hero__copy{
  max-width:600px;
  position:relative;
  z-index:3;
}


.pl-d1{
  font-family:'Outfit',system-ui,sans-serif;
  text-transform:uppercase;
  letter-spacing:-.018em;
  font-weight:800;
  line-height:.87;
  color:#faf7fd;
  font-size:clamp(48px,8.6vw,112px);
  margin-bottom:20px;
  text-shadow:0 6px 40px rgba(2,20,19,.55);
}


.pl-d1 span{
  color:#f0a03c;
}


.pl-rule{
  display:flex;
  align-items:center;
  gap:13px;
  margin:0 0 20px;
  max-width:270px;
}


.pl-rule i{
  height:1px;
  flex:1;
  background:linear-gradient(
    90deg,
    rgba(236,230,247,.44),
    transparent
  );
}


.pl-rule svg{
  width:16px;
  height:16px;
  color:#f0a03c;
  flex:0 0 auto;
}


.pl-lede{
  font-size:clamp(15px,1.35vw,17.5px);
  color:rgba(236,230,247,.74);
  max-width:44ch;
}


/* =========================================================
   CTA
   ========================================================= */

.pl-hero__cta{
  display:flex;
  gap:11px;
  flex-wrap:wrap;
  margin-top:26px;
  align-items:flex-start;
}


.pl-btn{
  display:inline-flex;
  flex:0 0 auto;
  width:fit-content;
  align-items:center;
  gap:10px;
  height:46px;
  padding:0 22px;
  border-radius:999px;
  font-size:12.5px;
  font-weight:700;
  letter-spacing:.13em;
  text-transform:uppercase;
  transition:.35s cubic-bezier(.2,.7,.2,1);
  white-space:nowrap;
  text-decoration:none;
}


.pl-btn svg{
  width:15px;
  height:15px;
  flex:0 0 auto;
}


.pl-btn--primary{
  background:linear-gradient(
    135deg,
    #c9761d,
    #5d8d1c
  );
  color:#08211a;
  box-shadow:
    0 12px 30px rgba(201,118,29,.34),
    inset 0 1px 0 rgba(255,255,255,.34);
}


.pl-btn--primary:hover{
  transform:translateY(-2px);
}


.pl-btn--ghost{
  background:rgba(236,230,247,.10);
  border:1px solid rgba(236,230,247,.30);
  backdrop-filter:blur(12px);
  color:#faf7fd;
}


.pl-btn--ghost:hover{
  background:rgba(236,230,247,.18);
  transform:translateY(-2px);
}


/* =========================================================
   GLASS EFFECT
   ========================================================= */

.pl-glass2{
  background:linear-gradient(
    158deg,
    rgba(236,230,247,.10),
    rgba(0,48,46,.22)
  );
  backdrop-filter:blur(18px) saturate(135%);
  -webkit-backdrop-filter:blur(18px) saturate(135%);
  border:1px solid rgba(236,230,247,.16);
  border-radius:26px;
  box-shadow:
    0 18px 48px rgba(18,12,34,.36),
    inset 0 1px 0 rgba(255,255,255,.16);
  position:relative;
  overflow:hidden;
}


/* =========================================================
   TRUST BADGES
   ========================================================= */

.pl-badges{
  position:absolute;
  right:18px;
  top:50%;
  transform:translateY(-50%);
  width:96px;
  z-index:4;
  display:flex;
  flex-direction:column;
  gap:2px;
  padding:12px 8px;
  border-radius:20px;
}


.pl-badge{
  text-align:center;
  padding:11px 4px;
}


.pl-badge+.pl-badge{
  border-top:1px solid rgba(236,230,247,.14);
}


.pl-badge__icon{
  width:38px;
  height:38px;
  margin:0 auto 8px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:rgba(236,230,247,.10);
  border:1px solid rgba(236,230,247,.22);
  color:#f0a03c;
}


.pl-badge__icon svg{
  width:19px;
  height:19px;
}


.pl-badge span{
  display:block;
  font-size:8.5px;
  font-weight:700;
  letter-spacing:.11em;
  text-transform:uppercase;
  color:rgba(236,230,247,.74);
  line-height:1.34;
}


.pl-badgestrip{
  display:none;
  gap:8px;
  margin-top:24px;
}


.pl-badgestrip .pl-glass2{
  flex:1;
  text-align:center;
  padding:11px 6px;
  border-radius:14px;
  font-size:8.5px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:rgba(236,230,247,.74);
  line-height:1.3;
}


.pl-badgestrip svg{
  width:18px;
  height:18px;
  margin:0 auto 6px;
  color:#f0a03c;
  display:block;
}


/* =========================================================
   PRODUCT STAGE
   ========================================================= */

.pl-hero__prod{
  position:absolute;
  right:2%;
  bottom:28px;
  width:min(42vw,440px);
  z-index:2;
  filter:drop-shadow(
    0 34px 54px rgba(2,20,19,.6)
  );
}


.pl-hstage{
  position:relative;
  width:100%;
  aspect-ratio:3/4;
  height:auto;
  max-height:clamp(380px,74svh,680px);
  border-radius:26px;
  overflow:hidden;
  background:rgba(23,16,43,.3);
  border:1px solid rgba(236,230,247,.14);
}


/* =========================================================
   HERO SLIDES
   ========================================================= */

.pl-hslide{
  position:absolute;
  inset:0;
  display:block;
  opacity:0;
  pointer-events:none;
  transition:opacity .85s cubic-bezier(.2,.7,.2,1);
}


.pl-hslide.pl-on{
  opacity:1;
  pointer-events:auto;
}


.pl-hp{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}


.pl-hp--placeholder{
  width:100%;
  height:100%;
  background:rgba(236,230,247,.12);
  border-radius:0;
}


/* =========================================================
   PRODUCT THUMBNAILS
   ========================================================= */

.pl-hp-thumbs{
  position:absolute;
  top:14px;
  right:14px;
  display:flex;
  flex-direction:column;
  gap:8px;
  z-index:5;
}


.pl-hp-thumb{
  width:52px;
  height:52px;
  border-radius:50%;
  object-fit:cover;
  border:2px solid rgba(236,230,247,.7);
  box-shadow:0 8px 18px rgba(2,20,19,.5);
}


.pl-hp-thumb--empty{
  display:block;
  background:rgba(236,230,247,.2);
  border:2px solid rgba(236,230,247,.4);
}


/* =========================================================
   PRODUCT PRICE TAG
   ========================================================= */

/*
  UPDATED:
  - Added smooth transform transition
  - Active slide = scale(1)
  - Inactive slide = scale(.9)
*/

.pl-ptag{
  position:absolute;
  left:0;
  bottom:2%;
  z-index:6;
  padding:11px 14px 12px;
  border-radius:16px;
  max-width:52%;
  transition:transform .5s cubic-bezier(.34,1.56,.64,1);
}


.pl-hslide.pl-on .pl-ptag{
  transform:scale(1);
}


.pl-hslide:not(.pl-on) .pl-ptag{
  transform:scale(.9);
}


.pl-ptag .pl-lbl{
  display:block;
  font-size:9px;
  font-weight:800;
  letter-spacing:.17em;
  text-transform:uppercase;
  color:#f0a03c;
}


.pl-ptag .pl-val{
  display:flex;
  align-items:baseline;
  gap:7px;
  margin-top:5px;
}


.pl-ptag .pl-val strong{
  font-family:'Outfit',sans-serif;
  font-size:23px;
  font-weight:800;
  letter-spacing:-.02em;
  color:#faf7fd;
  line-height:1;
}


.pl-ptag .pl-val s{
  font-size:12px;
  color:rgba(236,230,247,.52);
}


.pl-ptag .pl-cut{
  display:inline-block;
  margin-top:7px;
  font-size:8.4px;
  font-weight:800;
  letter-spacing:.11em;
  text-transform:uppercase;
  padding:3px 8px;
  border-radius:999px;
  background:rgba(240,160,60,.20);
  border:1px solid rgba(240,160,60,.38);
  color:#f0a03c;
}


/* =========================================================
   CAROUSEL DOTS
   ========================================================= */

.pl-hdots{
  display:flex;
  gap:7px;
  justify-content:center;
  align-items:center;
  margin-top:8px;
}


.pl-hdots button{
  width:6px;
  height:6px;
  padding:0;
  border-radius:50%;
  background:rgba(236,230,247,.28);
  transition:.4s cubic-bezier(.2,.7,.2,1);
  border:none;
  cursor:pointer;
}


.pl-hdots button.pl-on{
  background:#f0a03c;
  width:20px;
  border-radius:999px;
}


/* =========================================================
   SCROLL REVEAL
   ========================================================= */

.pl-rv{
  opacity:0;
  transform:translateY(30px);
  filter:blur(7px);
  transition:
    opacity .95s cubic-bezier(.2,.7,.2,1),
    transform .95s cubic-bezier(.2,.7,.2,1),
    filter .95s cubic-bezier(.2,.7,.2,1);
}


.pl-rv.pl-in{
  opacity:1;
  transform:none;
  filter:none;
}


.pl-rv-d1{
  transition-delay:.09s;
}


.pl-rv-d2{
  transition-delay:.18s;
}


.pl-rv-d3{
  transition-delay:.27s;
}


.pl-rv-d4{
  transition-delay:.36s;
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media(prefers-reduced-motion:reduce){

  .pl-rv,
  .pl-hslide,
  .pl-ptag,
  .pl-hero::after{
    transition:none!important;
    animation:none!important;
  }

  .pl-rv{
    opacity:1;
    transform:none;
    filter:none;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media(max-width:1199px){

  .pl-hero__prod{
    width:min(44vw,440px);
    right:3%;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:899px){

  .pl-hero{
    padding:120px 0 34px;
  }


  .pl-badges{
    display:none;
  }


  .pl-hero__copy{
    max-width:none;
  }


  .pl-badgestrip{
    display:flex;
  }


  .pl-hero__prod{
    position:relative;
    right:auto;
    bottom:auto;
    width:min(88vw,420px);
    margin:20px auto 0;
  }


  .pl-ptag{
    padding:9px 12px 10px;
    border-radius:14px;
    max-width:58%;
  }


  .pl-ptag .pl-val strong{
    font-size:20px;
  }

}

{% endstylesheet %}


{% javascript %}

document.querySelectorAll('[data-pl-hero-prod]').forEach(function(stage) {

  var dots = stage.querySelectorAll('[data-pl-dot]');
  var slides = stage.querySelectorAll('[data-pl-slide]');


  function show(n) {

    slides.forEach(function(s) {

      s.classList.toggle(
        'pl-on',
        s.getAttribute('data-n') === String(n)
      );

    });


    dots.forEach(function(d) {

      d.classList.toggle(
        'pl-on',
        d.getAttribute('data-n') === String(n)
      );

    });

  }


  dots.forEach(function(dot) {

    dot.addEventListener('click', function() {

      show(dot.getAttribute('data-n'));

    });

  });

});


// =========================================================
// SCROLL REVEAL
// =========================================================

var plObserver = new IntersectionObserver(
  function(entries) {

    entries.forEach(function(entry) {

      if (entry.isIntersecting) {
        entry.target.classList.add('pl-in');
      }

    });

  },
  {
    threshold:0.2
  }
);


document.querySelectorAll('.pl-hero .pl-rv').forEach(function(el) {

  plObserver.observe(el);

});

{% endjavascript %}


